# GIT

# --- gitenv symlinks ----------------------------------------------------------

_zsh_git_symlink() {
	local src="$1"
	local dest="$2"

	if [[ -L "$dest" ]]; then
		return 0
	elif [[ -e "$dest" ]]; then
		mv "$dest" "${dest}.bak"
		echo "zsh_git: backup ${dest} -> ${dest}.bak"
	fi

	ln -s "$src" "$dest"
	echo "zsh_git: linked ${dest} -> ${src}"
}

_zsh_git_setup_gitenv() {
	local gitenv="${DOTFILES:+$DOTFILES/.gitenv}"
	gitenv="${gitenv:-${HOME}/.files/.gitenv}"

	[[ -d "$gitenv" ]] || return 0

	_zsh_git_symlink "${gitenv}/.gitconfig" "${HOME}/.gitconfig"
}

_zsh_git_setup_pass_entries() {
	# Initialize pass entries if needed
	if command -v pass >/dev/null 2>&1; then
		local ghp_rewrite
		ghp_rewrite="$(git config --global --get-all 'url.https://github.com/.insteadof' 2>/dev/null)"

		# Only require a GitHub PAT pass entry when gh-p resolves to HTTPS.
		if grep -qx 'gh-p:' <<< "$ghp_rewrite"; then
			if ! pass show github.com/mikepadiernos >/dev/null 2>&1 \
				&& ! pass show github/mikepadiernos >/dev/null 2>&1; then
				echo "zsh_git: GitHub PAT not found in pass — create one entry:"
				echo "  pass insert github.com/mikepadiernos"
				echo "  (or: pass insert github/mikepadiernos)"
			fi
		fi

		# Ensure gpg key passphrase entry exists (optional)
		if ! pass show gpg/key-passphrase >/dev/null 2>&1; then
			if [[ -n "$GIT_SETUP_VERBOSE" ]]; then
				echo "zsh_git: gpg/key-passphrase not in pass — create it:"
				echo "  pass insert gpg/key-passphrase"
				echo "  (then paste your GPG key passphrase)"
			fi
		fi
	fi
}

_zsh_git_setup_gitenv
_zsh_git_setup_pass_entries
unset -f _zsh_git_symlink _zsh_git_setup_gitenv _zsh_git_setup_pass_entries

# --- mergetool ----------------------------------------------------------------

_zsh_git_pick_mergetool() {
	local tool
	for tool in nvimdiff vimdiff meld kdiff3; do
		local bin="${tool%diff}"
		[[ "$tool" == "nvimdiff" ]] && bin="nvim"
		[[ "$tool" == "vimdiff"  ]] && bin="vim"
		command -v "$bin" >/dev/null 2>&1 && echo "$tool" && return 0
	done
	return 1
}

_zsh_git_setup_mergetool() {
	local configured_tool selected_tool

	configured_tool="$(git config --global --get merge.tool 2>/dev/null)"
	[[ -n "$configured_tool" ]] && return 0

	selected_tool="$(_zsh_git_pick_mergetool)" || return 0

	git config --global merge.tool         "$selected_tool"
	git config --global mergetool.prompt   false
	git config --global mergetool.keepBackup false

	[[ -n "$GIT_SETUP_VERBOSE" ]] && \
		echo -e "\e[30;42m GIT \e[0m" "\e[32mmerge.tool set to $selected_tool\e[0m"
}

_zsh_git_setup_mergetool
unset -f _zsh_git_pick_mergetool _zsh_git_setup_mergetool

# --- dynamic identity ---------------------------------------------------------

_zsh_git_sync_identity() {
	command -v git >/dev/null 2>&1 || return 0
	git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

	local repo_root remote_url target_name target_email
	repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
	remote_url="$(git config --get remote.origin.url 2>/dev/null)"

	if [[ "$repo_root" == "$HOME/Library/Projects/work"/* ]] || [[ "$remote_url" == *"ge-aero/"* ]]; then
		target_name="570006541_aero"
		target_email="michael.padiernos@geaerospace.com"
	else
		target_name="mikepadiernos"
		target_email="mike@padiernos.me"
	fi

	local current_name current_email
	current_name="$(git config --local --get user.name 2>/dev/null || true)"
	current_email="$(git config --local --get user.email 2>/dev/null || true)"

	[[ "$current_name" == "$target_name" ]] || git config --local user.name "$target_name"
	[[ "$current_email" == "$target_email" ]] || git config --local user.email "$target_email"
}

if [[ -o interactive ]] && whence -w add-zsh-hook >/dev/null 2>&1; then
	add-zsh-hook chpwd _zsh_git_sync_identity
	add-zsh-hook precmd _zsh_git_sync_identity
	_zsh_git_sync_identity
fi

# END GIT
