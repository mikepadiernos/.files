#!/bin/zsh
## ZSH_PLUGINS
## ---

source_if_exists() {
	local file="$1"
	[[ -f "$file" ]] && source "$file"
}

source_plugin() {
    local plugin="$1"
    local plugin_file="$ZSH_PLUGINS/$plugin/$plugin.plugin.zsh"

    source_if_exists "$plugin_file"
}

