#!/bin/zsh
## ZSH_PLUGINS
## ---

source_if_exists() {
	local file="$1"
	[[ -f "$file" ]] && source "$file"
}

source_plugin() {
    local plugin="$1"
    local plugin_file="$ZSH_PLUGINS/$plugin/$plugin.plugin.zsh"

    source_if_exists "$plugin_file"
}

# composer
# ddev
# gh
# git
# lando-alias-zsh
# zeza
# zsh-alias-finder

source_plugin "zsh-abbr"                                                                          # zsh-abbr
source_plugin "zsh-autocompletion"                                                                # zsh-autocompletion
source_plugin "zsh-autosuggestions"                                                               # zsh-autosuggestions
source_plugin "zsh-colors"                                                                        # zsh-colors
source_plugin "zsh-completions"                                                                   # zsh-completions
source_plugin "zsh-doas-zsh-plugin"                                                               # zsh-doas-zsh-plugin
source_plugin "zsh-docker-helpers"                                                                # zsh-docker-helpers
source_plugin "zsh-drupal"                                                                        # zsh-drupal
source_plugin "zsh-eza"                                                                           # zsh-eza
source_plugin "zsh-F-Sy-H"                                                                        # zsh-F-Sy-H
source_plugin "zsh-figures"                                                                       # zsh-figures
source_plugin "zsh-fzf-git-branches"                                                              # zsh-fzf-git-branches
source_plugin "zsh-fzf-plugin"                                                                    # zsh-fzf-plugin
source_plugin "zsh-fzf-tab"                                                                       # zsh-fzf-tab
source_plugin "zsh-magic-dashboard"                                                               # zsh-magic-dashboard
source_plugin "zsh-ssh"                                                                           # zsh-ssh
source_plugin "zsh-you-should-use"                                                                # zsh-you-should-use

## ---
## END ZSH_PLUGINS
