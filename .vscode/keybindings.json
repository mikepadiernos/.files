// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+c",
        "command": "editor.action.clipboardCopyAction",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "ctrl+x",
        "command": "editor.action.clipboardCutAction",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "ctrl+meta+/",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+`",
        "command": "-workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+meta+space",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+b",
        "command": "-workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+meta+enter",
        "command": "workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+alt+b",
        "command": "-workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+meta+\\",
        "command": "workbench.action.toggleMaximizedAuxiliaryBar"
    },
    {
        "key": "ctrl+meta+]",
        "command": "lazygit-vscode.toggle"
    },
    {
        "key": "ctrl+shift+l",
        "command": "-lazygit-vscode.toggle"
    },
    {
        "key": "ctrl+meta+\\",
        "command": "yazi-vscode.toggle"
    },
    {
        "key": "ctrl+shift+y",
        "command": "-yazi-vscode.toggle"
    },
    {
        "key": "ctrl+meta+'",
        "command": "workbench.action.maximizeAuxiliaryBar"
    },
    {
        "key": "ctrl+shift+u",
        "command": "workbench.action.browser.focusUrlInput",
        "when": "activeEditor == 'workbench.editor.browser'"
    },
    {
        "key": "ctrl+l",
        "command": "-workbench.action.browser.focusUrlInput",
        "when": "activeEditor == 'workbench.editor.browser'"
    },
    {
        "key": "ctrl+meta+[",
        "command": "mikepadiernos.lazydockerEditor.openLazydocker"
    },
    {
        "key": "ctrl+g d",
        "command": "mikepadiernos.lazydockerEditor.openLazydocker"
    }
    ,
    {
        "key": "ctrl+alt+1",
        "command": "workbench.action.chat.open",
        "args": {
            "query": "Use Rally MCP only. Pull latest discussion posts for all user stories in this workspace and update each discussion/README.md with only new comments (skip exact duplicates).",
            "isPartialQuery": false,
            "execute": true
        },
        "when": "workspaceFolderCount > 0 && !terminalFocus"
    },
    {
        "key": "ctrl+alt+2",
        "command": "workbench.action.chat.open",
        "args": {
            "query": "Use Rally MCP only. Scan local discussion/README.md files and post new local comments to Rally. If an exact comment already exists in Rally, skip it.",
            "isPartialQuery": false,
            "execute": true
        },
        "when": "workspaceFolderCount > 0 && !terminalFocus"
    },
    {
        "key": "ctrl+alt+3",
        "command": "workbench.action.chat.open",
        "args": {
            "query": "Use Rally MCP only. Full sync discussions: pull latest Rally comments to local files, then post local-only comments to Rally, skipping exact duplicates both directions.",
            "isPartialQuery": false,
            "execute": true
        },
        "when": "workspaceFolderCount > 0 && !terminalFocus"
    }
]
