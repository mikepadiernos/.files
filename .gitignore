# Application runtime data

# Atuin
.atuin/data/*.db*

# CopyQ
.copyq/*.dat
.copyq/copyq.lock

# davfs2
.davfs2/

# Neovim
.neovim/

# qutebrowser
.qute/__pycache__/
.qute/share/keepassxc.key*
.qute/scripts/qute-keepassxc

# tmux plugins
.tmux/plugins/*/

# Zen Browser
.zen/