# Keep tracked historical data
!historical/

# System / generic
.DS_store

# Logs / sync artifacts
.nexcloudsync.log

# Copilot cache
.copilot-specs-cache/

# App runtime data

# Atuin
.atuin/**/*.db
.atuin/**/*.db-shm
.atuin/**/*.db-wal

# CopyQ
.copyq/*.dat
.copyq/copyq.lock

# davfs2
.davfs2/

# Neovim
.neovim/
.neovim/*/

# qutebrowser cache/local secrets
.qute/__pycache__/
.qute/share/keepassxc.key*

# tmux plugins
.tmux/plugins/*/

# Zen Browser
.zen/

# zsh runtime/cache
.zsh/.historical/
.zsh/history/
.zsh/plugins/zsh*/
.zsh/themes/minimal/
.zsh/themes/typewritten/
!.zsh/plugins/git_repos.txt

# Optional ignores
# .filecentipede/lib/
# .msmtp/*.log
# .openaudible/tmp/
