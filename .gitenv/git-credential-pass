#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-get}"

protocol=""
host=""
path=""
username=""
password=""

while IFS='=' read -r key value; do
	[[ -z "$key" ]] && break
	case "$key" in
		protocol) protocol="$value" ;;
		host) host="$value" ;;
		path) path="$value" ;;
		username) username="$value" ;;
		password) password="$value" ;;
	esac
done

if [[ -z "$host" ]]; then
	exit 0
fi

owner="${path%%/*}"
owner="${owner%.git}"

pass_get() {
	local entry="$1"
	pass show "$entry" 2>/dev/null || return 1
}

select_entry() {
	local -a candidates=()
	[[ -n "$owner" ]] && candidates+=("${host}/${owner}" "${host%.*}/${owner}")
	[[ -n "$username" ]] && candidates+=("${host}/${username}" "${host%.*}/${username}")
	# Personal fallbacks
	candidates+=("${host}/mikepadiernos" "github/mikepadiernos")

	local c
	for c in "${candidates[@]}"; do
		if pass_get "$c" >/dev/null; then
			echo "$c"
			return 0
		fi
	done
	return 1
}

parse_user_from_secret() {
	local secret="$1"
	local line
	while IFS= read -r line; do
		case "$line" in
			username=*|login=*)
				echo "${line#*=}" | sed 's/^ *//; s/ *$//'
				return 0
				;;
		esac
	done <<< "$secret"
	return 1
}

default_user_for_owner() {
	local owner_name="$1"
	case "$owner_name" in
		ge-aero)
			echo "570006541_aero"
			;;
		mikepadiernos)
			echo "mikepadiernos"
			;;
		*)
			echo "${entry##*/}"
			;;
	esac
}

case "$cmd" in
	get)
		entry="$(select_entry || true)"
		[[ -z "$entry" ]] && exit 0
		secret="$(pass_get "$entry" || true)"
		[[ -z "$secret" ]] && exit 0

		secret_password="$(printf '%s\n' "$secret" | head -n1)"
		secret_user="$(parse_user_from_secret "$secret" || true)"

		if [[ -z "$secret_user" ]]; then
			secret_user="$(default_user_for_owner "$owner")"
		fi

		printf 'username=%s\n' "$secret_user"
		printf 'password=%s\n\n' "$secret_password"
		;;
	store)
		# Save credential into pass under host/username for future reuse.
		if [[ -n "$username" && -n "$password" ]]; then
			entry="${host}/${username}"
			printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
			if [[ -n "$owner" ]]; then
				entry="${host}/${owner}"
				printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
			fi
		fi
		;;
	erase)
		if [[ -n "$username" ]]; then
			entry="${host}/${username}"
			pass rm -f "$entry" >/dev/null 2>&1 || true
		fi
		;;
	*)
		exit 0
		;;
esac

exit 0
