#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-get}"

protocol=""
host=""
path=""
username=""
password=""

while IFS='=' read -r key value; do
	[[ -z "$key" ]] && break
	case "$key" in
		protocol) protocol="$value" ;;
		host) host="$value" ;;
		path) path="$value" ;;
		username) username="$value" ;;
		password) password="$value" ;;
	esac
done

if [[ -z "$host" ]]; then
	exit 0
fi

host_short="${host%%.*}"

owner="${path%%/*}"
owner="${owner%.git}"
repo_path_raw="$path"
repo_path="${path%.git}"

debug() {
	[[ "${GIT_CREDENTIAL_PASS_DEBUG:-0}" == "1" ]] || return 0
	echo "git-credential-pass: $*" >&2
}

pass_get() {
	local entry="$1"
	pass show "$entry" 2>/dev/null || return 1
}

select_entry() {
	local -a candidates=()
	local protocol_root=""

	if [[ -n "$protocol" ]]; then
		case "$host" in
			github.com|gitlab.com|bitbucket.org)
				protocol_root="${host%%.*}"
				;;
		esac
		if [[ -z "$protocol_root" && "$host_short" != "$host" ]]; then
			protocol_root="$host_short"
		fi
		if [[ -n "$protocol_root" ]]; then
			if [[ -n "$repo_path" ]]; then
				candidates+=("${protocol_root}/${protocol}/${repo_path}")
				candidates+=("${protocol_root}/${protocol}/${repo_path_raw}")
				[[ "$host_short" != "$host" ]] && candidates+=("${host}/${protocol}/${repo_path}")
				[[ "$host_short" != "$host" ]] && candidates+=("${host_short}/${protocol}/${repo_path}")
			fi
			if [[ -n "$owner" ]]; then
				candidates+=("${protocol_root}/${protocol}/${owner}")
				[[ "$host_short" != "$host" ]] && candidates+=("${host}/${protocol}/${owner}")
				[[ "$host_short" != "$host" ]] && candidates+=("${host_short}/${protocol}/${owner}")
			fi
			if [[ -n "$username" ]]; then
				candidates+=("${protocol_root}/${protocol}/${username}")
				[[ "$host_short" != "$host" ]] && candidates+=("${host}/${protocol}/${username}")
				[[ "$host_short" != "$host" ]] && candidates+=("${host_short}/${protocol}/${username}")
			fi
		fi
	fi

	# Prefer repository-path entries, then owner, then requested username.
	# Accept both host forms (e.g. github.com/... and github/...).
	if [[ -n "$repo_path" ]]; then
		candidates+=("${host}/${repo_path}")
		[[ "$host_short" != "$host" ]] && candidates+=("${host_short}/${repo_path}")
	fi
	if [[ -n "$repo_path_raw" ]]; then
		candidates+=("${host}/${repo_path_raw}")
		[[ "$host_short" != "$host" ]] && candidates+=("${host_short}/${repo_path_raw}")
	fi
	if [[ -n "$owner" ]]; then
		candidates+=("${host}/${owner}")
		[[ "$host_short" != "$host" ]] && candidates+=("${host_short}/${owner}")
	fi
	if [[ -n "$username" ]]; then
		candidates+=("${host}/${username}")
		[[ "$host_short" != "$host" ]] && candidates+=("${host_short}/${username}")
	fi

	local c
	for c in "${candidates[@]}"; do
		debug "trying entry '$c'"
		if pass_get "$c" >/dev/null; then
			debug "matched entry '$c'"
			echo "$c"
			return 0
		fi
	done
	debug "no entry matched for host='$host' path='$path' username='${username:-}'"
	return 1
}

parse_user_from_secret() {
	local secret="$1"
	local line
	while IFS= read -r line; do
		case "$line" in
			username=*|login=*)
				echo "${line#*=}" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
				return 0
				;;
		esac
	done <<< "$secret"
	return 1
}

default_user_for_owner() {
	local owner_name="$1"
	# Best-effort fallback when secret has no username/login metadata.
	# For GitHub HTTPS remotes, owner is typically a valid username for user repos.
	if [[ -n "$owner_name" ]]; then
		echo "$owner_name"
	elif [[ -n "$username" ]]; then
		echo "$username"
	else
		echo "git"
	fi
}

case "$cmd" in
	get)
		debug "cmd=get host='$host' path='$path' owner='$owner' repo_path='$repo_path'"
		entry="$(select_entry || true)"
		[[ -z "$entry" ]] && exit 0
		secret="$(pass_get "$entry" || true)"
		[[ -z "$secret" ]] && exit 0

		secret_password="$(printf '%s\n' "$secret" | head -n1 | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
		secret_user="$(parse_user_from_secret "$secret" || true)"

		if [[ -z "$secret_user" ]]; then
			secret_user="$(default_user_for_owner "$owner")"
		fi

		printf 'username=%s\n' "$secret_user"
		printf 'password=%s\n\n' "$secret_password"
		;;
	store)
		# Save credential into pass under host/username for future reuse.
		if [[ -n "$username" && -n "$password" ]]; then
			local protocol_root=""
			case "$host" in
				github.com|gitlab.com|bitbucket.org)
					protocol_root="${host%%.*}"
					;;
			esac
			if [[ -n "$protocol" && -n "$protocol_root" ]]; then
				if [[ -n "$owner" ]]; then
					entry="${protocol_root}/${protocol}/${owner}"
					printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
				fi
				if [[ -n "$repo_path" ]]; then
					entry="${protocol_root}/${protocol}/${repo_path}"
					printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
				fi
				if [[ -n "$username" ]]; then
					entry="${protocol_root}/${protocol}/${username}"
					printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
				fi
			fi

			entry="${host}/${username}"
			printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
			if [[ "$host_short" != "$host" ]]; then
				entry="${host_short}/${username}"
				printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
			fi
			if [[ -n "$owner" ]]; then
				entry="${host}/${owner}"
				printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
				if [[ "$host_short" != "$host" ]]; then
					entry="${host_short}/${owner}"
					printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
				fi
			fi
			if [[ -n "$repo_path" ]]; then
				entry="${host}/${repo_path}"
				printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
				if [[ "$host_short" != "$host" ]]; then
					entry="${host_short}/${repo_path}"
					printf '%s\nusername=%s\n' "$password" "$username" | pass insert -m -f "$entry" >/dev/null 2>&1 || true
				fi
			fi
		fi
		;;
	erase)
		if [[ -n "$username" ]]; then
			entry="${host}/${username}"
			pass rm -f "$entry" >/dev/null 2>&1 || true
			if [[ "$host_short" != "$host" ]]; then
				entry="${host_short}/${username}"
				pass rm -f "$entry" >/dev/null 2>&1 || true
			fi
		fi
		if [[ -n "$owner" ]]; then
			entry="${host}/${owner}"
			pass rm -f "$entry" >/dev/null 2>&1 || true
			if [[ "$host_short" != "$host" ]]; then
				entry="${host_short}/${owner}"
				pass rm -f "$entry" >/dev/null 2>&1 || true
			fi
		fi
		if [[ -n "$repo_path" ]]; then
			entry="${host}/${repo_path}"
			pass rm -f "$entry" >/dev/null 2>&1 || true
			if [[ "$host_short" != "$host" ]]; then
				entry="${host_short}/${repo_path}"
				pass rm -f "$entry" >/dev/null 2>&1 || true
			fi
		fi
		;;
	*)
		exit 0
		;;
esac

exit 0
